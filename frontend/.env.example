# Copy to frontend/.env.local for local overrides; in production set these on the host.

# The Django API, called only from the Next.js server (never from the browser).
# Required in production; defaults to http://127.0.0.1:8001/api in development.
# API_URL=https://api.applytrack.id/api

# Same value as the backend's FRONTEND_PROXY_SECRET: lets Django rate-limit each visitor
# instead of treating everyone as this server. Required in production.
# FRONTEND_PROXY_SECRET=a-long-random-string

# Shown on /privacy for personal-data requests. Until set, the page says it will be published.
# CONTACT_EMAIL=privasi@applytrack.my.id
