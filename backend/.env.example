# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by git — never commit it.

# Generate one with:
#   .venv\Scripts\python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me

# True only for local development.
DJANGO_DEBUG=True

# Comma-separated hostnames the backend may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
