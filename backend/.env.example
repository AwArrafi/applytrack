# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by git — never commit it. In production, set these as the host's
# environment variables instead of using a file.

# ---- Required ----------------------------------------------------------------------------

# Long and random. Generate one with:
#   .venv\Scripts\python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me

# True only for local development (also: tests expect True, see DJANGO_SECURE_SSL_REDIRECT).
DJANGO_DEBUG=True

# Comma-separated hostnames the backend may serve, e.g. api.applytrack.id
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Production --------------------------------------------------------------------------

# PostgreSQL. Leave empty locally to use the db.sqlite3 file.
# DATABASE_URL=postgres://user:password@host:5432/applytrack?sslmode=require

# Full origins (with https://) allowed to post forms, e.g. the admin's sign-in page.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.applytrack.id

# Email for password resets, via Resend's SMTP (https://resend.com). Without EMAIL_HOST,
# emails are printed to the Django console instead, which is handy for local testing.
# The password is a Resend API key; the sender must use a domain verified in Resend.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=ApplyTrack <no-reply@applytrack.id>

# The frontend's address; password reset emails link to FRONTEND_URL/reset-password.
FRONTEND_URL=http://localhost:3000

# A less guessable admin path, ending in a slash.
# DJANGO_ADMIN_URL=kelola-7f3a/

# Only read when DJANGO_DEBUG=False. Redirect HTTP to HTTPS (turn off for tests in CI).
# DJANGO_SECURE_SSL_REDIRECT=True
# How long browsers remember to use HTTPS only. Start with 3600 on a new domain.
# DJANGO_HSTS_SECONDS=31536000

# ---- Optional ----------------------------------------------------------------------------

# Your time zone (IANA name), used for "today" on the dashboard.
DJANGO_TIME_ZONE=Asia/Jakarta

# Days a sign-in lasts.
# AUTH_TOKEN_TTL_DAYS=30

# DJANGO_LOG_LEVEL=INFO

# Run in production with:
#   python manage.py migrate && python manage.py collectstatic --noinput
#   gunicorn config.wsgi --bind 0.0.0.0:$PORT --workers 3
