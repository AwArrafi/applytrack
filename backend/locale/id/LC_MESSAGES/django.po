# Indonesian translations for ApplyTrack's own messages. Django and DRF ship their
# own translations for built-in messages ("This field may not be blank." etc).
# After editing: python manage.py compilemessages
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: id\n"

msgid "Must be at least the minimum salary."
msgstr "Harus sama dengan atau lebih besar dari gaji minimum."

msgid "An account with this email already exists."
msgstr "Akun dengan email ini sudah terdaftar."

msgid "Email or password is incorrect."
msgstr "Email atau kata sandi salah."

msgid "Your session has expired. Please sign in again."
msgstr "Sesi Anda telah berakhir. Silakan masuk kembali."

msgid "Give both from and to as YYYY-MM-DD dates."
msgstr "Isi from dan to dengan format tanggal YYYY-MM-DD."

msgid "The date range must run forwards and span at most 62 days."
msgstr "Rentang tanggal harus maju dan paling panjang 62 hari."

msgid "%(value)s is not a known time zone."
msgstr "%(value)s bukan zona waktu yang dikenal."

msgid "Reset your ApplyTrack password"
msgstr "Atur ulang kata sandi ApplyTrack Anda"

msgid ""
"Hello {name},\n"
"\n"
"Someone asked to reset the password of your ApplyTrack account. To choose a new one, open this link within one hour:\n"
"\n"
"{link}\n"
"\n"
"If you didn't ask for this, ignore this email; your password stays the same."
msgstr ""
"Halo {name},\n"
"\n"
"Ada permintaan untuk mengatur ulang kata sandi akun ApplyTrack Anda. Untuk membuat kata sandi baru, buka tautan berikut dalam waktu satu jam:\n"
"\n"
"{link}\n"
"\n"
"Jika Anda tidak merasa meminta ini, abaikan email ini; kata sandi Anda tidak berubah."

msgid "This link is invalid or has expired."
msgstr "Tautan ini tidak valid atau sudah kedaluwarsa."

msgid "Your current password is incorrect."
msgstr "Kata sandi saat ini salah."

msgid "Paste the full text of the email."
msgstr "Tempelkan seluruh isi email."

msgid ""
"This email is not one ApplyTrack recognises yet. For now, only JobStreet emails "
"can be read."
msgstr "Email ini belum dapat dikenali. Untuk sementara, ApplyTrack hanya bisa membaca email dari JobStreet."

msgid "Your password is incorrect."
msgstr "Kata sandi Anda salah."
